# Sao chép file này vào thư mục bản export iOS của Unity (cùng cấp với Unity-iPhone.xcodeproj),
# đổi tên thành "Podfile", rồi chạy: pod install --repo-update nếu Xcode báo thiếu Swift module.
# Mở Unity-iPhone.xcworkspace (không mở .xcodeproj).
#
# Tránh trùng Firebase: nếu Podfile này đã có pod Firebase/* thì KHÔNG thêm firebase-ios-sdk
# qua Swift Package Manager lên UnityFramework / project Xcode — sẽ lỗi redefinition of module 'Firebase'.
#
# BẮT BUỘC: mở Terminal và cd vào ĐÚNG thư mục có cả Podfile và Unity-iPhone.xcodeproj
# (không chạy pod từ ~/Downloads hay thư mục cha). Nếu tên file .xcodeproj khác, sửa dòng project.

platform :ios, '15.0'

project 'Unity-iPhone.xcodeproj'

# Pods chỉ gắn target UnityFramework (không khai báo Unity-iPhone).
#
# Quan trọng: Sau pod install, CocoaPods link các SDK động (@rpath/*.framework) vào
# UnityFramework và thêm phase "[CP] Embed Pods Frameworks". Nếu gỡ embed/link Pods
# để tránh duplicate class thì runtime sẽ crash kiểu:
#   Library not loaded: @rpath/AdjustSdk.framework/AdjustSdk
#
# Hai yêu cầu xung đột với bản BBLModuleAds hiện tại:
# (1) File Modules/.../arm64-apple-ios.private.swiftinterface trong framework có các dòng
#     import AppsFlyerLib, Firebase*, GoogleMobileAds, UserMessagingPlatform — Xcode
#     BẮT BUỘC thấy các module đó khi build (thường qua CocoaPods). Gỡ các pod này sẽ
#     lỗi "Unable to find module dependency".
# (2) Nếu binary BBLModuleAds đồng thời đã nhúng (static) cùng các SDK đó, thêm pod sẽ
#     gây trùng lớp ObjC lúc chạy. Giải đúng: build lại BBLModuleAds "mỏng" (chỉ link động
#     với vendor, không nhúng trùng) hoặc gỡ SDK trùng phía Unity/plugin khác — xem
#     ios-project/.../docs/BUILD.md.
#     Log kiểu: "Class GAD... implemented in both ... BBLModuleAds.framework ... UnityFramework"
#     là triệu chứng trùng GoogleMobileAds/UMP giữa prebuilt BBL và Pod — cùng gốc (2).
#
# Lưu ý: Sau khi đổi Podfile, trong thư mục export chạy `pod deintegrate` rồi
# `pod install` (hoặc export lại Unity với ABI_IOS_PODFILE_OVERWRITE=1 nếu dùng postprocess).

target 'UnityFramework' do
  use_frameworks! :linkage => :dynamic

  # Bắt buộc cho swiftinterface của BBLModuleAds (module map / import Swift).
  pod 'Google-Mobile-Ads-SDK', '~> 12.0'
  pod 'GoogleUserMessagingPlatform'
  pod 'AppsFlyerFramework', '~> 6.0'
  pod 'Firebase/Analytics'
  pod 'Firebase/RemoteConfig'
  pod 'Firebase/Database'
  pod 'Firebase/Messaging'

  pod 'AppLovinSDK', '~> 13.0'
  pod 'Adjust', '~> 5.0'
  pod 'FBSDKCoreKit', '~> 18.0'
  pod 'lottie-ios', '~> 4.5'
end

# Host app target để CocoaPods tạo "[CP] Embed Pods Frameworks"
# và copy các dynamic frameworks (ví dụ AdjustSdk.framework) vào app bundle.
target 'Unity-iPhone' do
  use_frameworks! :linkage => :dynamic
  inherit! :search_paths
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end
  end

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        if target.name == 'UnityFramework'
          # Giữ inherited để không ghi đè runpath từ CocoaPods.
          config.build_settings['LD_RUNPATH_SEARCH_PATHS'] = [
            '$(inherited)',
            '@executable_path/Frameworks',
            '@loader_path/Frameworks'
          ]
        end
      end
    end
    aggregate_target.user_project.save
  end

  support_files_dir = installer.sandbox.root + 'Target Support Files'

  Dir.glob("#{support_files_dir}/**/*.sh").each do |script_path|
    script = File.read(script_path)
    patched = script
      .gsub('echo "$(realpath -mq "${0}"):$1: error: Unexpected failure"',
            'echo "${0}:$1: error: Unexpected failure"')
      .gsub('RESOURCES_TO_COPY=${PODS_ROOT}/resources-to-copy-${TARGETNAME}.txt',
            'RESOURCES_TO_COPY=${TARGET_TEMP_DIR}/resources-to-copy-${TARGETNAME}.txt')

    next if patched == script

    File.write(script_path, patched)
  end
end

# ABI Ads — merge into Assets/Plugins/Android/gradleTemplate.properties
# Unity 2022.3 + JDK 11. Keep Unity placeholders: **JVM_HEAP_SIZE**, **STREAMING_ASSETS**, **ADDITIONAL_PROPERTIES**
# Guide: docs/android-build-unity-2022-jdk11.md

org.gradle.jvmargs=-Xmx**JVM_HEAP_SIZE**M -XX:MaxMetaspaceSize=256m -Dfile.encoding=UTF-8 -Xss4m
org.gradle.parallel=false
org.gradle.workers.max=2
unityStreamingAssets=**STREAMING_ASSETS**
# Android Resolver Properties Start
android.useAndroidX=true
android.enableJetifier=true
android.lint.checkReleaseBuilds=false
# Android Resolver Properties End
**ADDITIONAL_PROPERTIES**

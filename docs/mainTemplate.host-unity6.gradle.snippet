// =============================================================================
// ABI Ads — host block for Assets/Plugins/Android/mainTemplate.gradle
// Unity 6 + JDK 17. Place ABOVE "// Android Resolver Dependencies Start".
// See README.md § Android build notes.
// =============================================================================

// ABI Ads — Unity 6 + JDK 17
configurations.configureEach {
    resolutionStrategy {
        eachDependency { details ->
            if (details.requested.group == 'androidx.lifecycle') {
                details.useVersion '2.6.2'
                details.because 'lifecycle alignment for ABI Ads module'
            }
        }
    }
}

dependencies {
    implementation 'com.google.android.gms:play-services-ads:25.3.0'
    implementation 'com.google.android.ump:user-messaging-platform:4.0.0'

    // --- Unity + EDM continue below (do not remove placeholders) ---
    // apply plugin: 'com.android.library'
    // apply from: '../shared/keepUnitySymbols.gradle'
    // implementation fileTree(dir: 'libs', include: ['*.jar'])
    // // Android Resolver Dependencies Start
    // ...

// ABI Ads — Firebase local Maven (Unity 6)
// Merge into dependencyResolutionManagement.repositories in settingsTemplate.gradle
// AFTER "// Android Resolver Repos End" (or before flatDir).
// Requires: Player Settings → Custom Gradle Settings Template.
// Guide: docs/android-build-unity-6.md

        def unityProjectPath = $/file:///**DIR_UNITYPROJECT**/$.replace("\\", "/")
        maven {
            url (unityProjectPath + "/Assets/Firebase/m2repository")
        }
        maven {
            url (unityProjectPath + "/Assets/GeneratedLocalRepo/Firebase/m2repository")
        }
